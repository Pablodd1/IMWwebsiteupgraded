# Copy these names into Vercel -> Settings -> Environment Variables (and into Railway for the voice bridge).
# NEVER commit real values. Names starting with NEXT_PUBLIC_ are visible to every visitor.

# ---------- AI (Vercel + Railway) ----------
XAI_API_KEY=                 # console.x.ai -> API keys. Used for chat/SMS (Vercel) and voice (Railway)
XAI_CHAT_MODEL=grok-4.7      # optional; text model for chat + SMS
XAI_VOICE_MODEL=grok-voice-latest   # optional; pin e.g. grok-voice-3.0 in production (Railway)
XAI_VOICE_REASONING=none     # optional; "none" = faster phone replies, "high" = smarter, slower (Railway)

# ---------- Shared secret (same value on Vercel AND Railway) ----------
BOT_API_SECRET=              # generate: openssl rand -hex 32  (signs call streams, protects /api/lead)

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=          # Twilio console -> Account Info
TWILIO_AUTH_TOKEN=           # Twilio console -> Account Info (validates webhooks; sends staff SMS; transfers calls)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX    # the clinic's Twilio number (used as the "From" for staff SMS)
PUBLIC_BASE_URL=https://innovativemedicalwellness.com   # exactly the domain Twilio calls (no trailing slash)
VOICE_BRIDGE_URL=wss://YOUR-BRIDGE.up.railway.app/twilio-stream   # Vercel: where /api/twilio/voice sends the call audio

# ---------- Where requests go (Vercel) ----------
STAFF_NOTIFY_EMAIL=          # who gets appointment / call-back requests (falls back to MYABABEEL)
STAFF_NOTIFY_PHONE=          # optional +1... number that gets a text for each request
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_TITLE=                 # Brevo SMTP login
EMAIL_PASS=                  # Brevo SMTP password (rotate: the old one was committed to git)
MYABABEEL=                   # existing contact-form recipient
SENDER=no-reply@innovativemedicalwellness.com
ENCRYPTION_KEY=              # rotate: openssl rand -hex 32

# ---------- AIMS intake link texted to patients after an appointment request (Vercel) ----------
INTAKE_URL=https://www.aimedicalscriber.com/intake/<docId>   # the doctor's public intake link from AIMS (QR/link button on the patient screen); must be https

# ---------- Other sites that embed the widget (Vercel) ----------
ALLOWED_ORIGINS=https://exomindmiamibeach.com,https://www.agingbiohacking.com

# ---------- Railway (voice bridge only) ----------
LEAD_ENDPOINT=https://innovativemedicalwellness.com/api/lead   # bridge posts requests here (keeps SMTP secrets on Vercel)
HANDOFF_PHONE=+1XXXXXXXXXX   # optional: live person for transfer_to_human (default in bot/config/clinic.json)
MAX_CONCURRENT_CALLS=10      # optional
MAX_CALL_MINUTES=15          # optional
# PORT is set by Railway automatically.

# ---------- Optional but recommended (Vercel): shared rate limits + SMS memory ----------
# Add Upstash Redis from the Vercel Marketplace; it sets these automatically:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Analytics (already in the site) ----------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
